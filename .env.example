# ---- 菜单数据来源 ----
# mock：离线示例菜单（默认，无需任何凭证，可直接演示）
# mcp ：真实麦当劳 MCP 门店数据（需要下面的 Token）
MENU_PROVIDER=mock

# ---- 麦当劳 MCP ----
# Token 只放在后端环境变量里，禁止写入前端、截图或提交仓库
MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=
MCD_MCP_TIMEOUT=12

# 门店编码。留空则由 query-nearby-stores 按城市+关键词自动选第一家
# 示例：1400205（麦当劳广州华夏路餐厅，仅作说明，非固定值）
MCD_STORE_ID=

# ---- 存储 ----
# 会话与事件库路径；目录不可写时会自动降级到内存并在 /api/health 标注
DB_PATH=./data/mind_swipe.db
SESSION_TTL_SEC=7200

# ---- 决策引擎（可调参数，见规划书 4.3 / 4.4）----
MAX_QUESTIONS=5
STOP_CONFIDENCE_GAP=0.075
QUESTION_VALUE_FLOOR=0.30

# ---- LLM（可选）----
# 关闭时全部走规则引擎，功能完整；开启后用于意图解析与问题文案润色
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
